# =========================================================
# Render Environment Variables Configuration
# Set these key-value pairs in Render Dashboard -> Environment
# =========================================================

# 1. Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# 2. Public User Bot Token (Optional, if using separate bot for users)
PUBLIC_BOT_TOKEN=

# 3. Your Telegram Chat ID (where girlfriend's answers will be sent)
OWNER_CHAT_ID=

# 4. Your Render Live URL (e.g. https://your-project.onrender.com)
WEB_APP_URL=

# 5. Admin secret for privileged API endpoints (/api/save_env, /api/test_bot).
#    When set, those endpoints require an `X-Admin-Secret` header match.
#    When unset, they accept loopback (127.0.0.1) requests only — i.e.
#    remote access is denied. Set a long random value in production.
ADMIN_SECRET=

# 5. Port (Render sets this automatically, default is 5000)
PORT=5000
